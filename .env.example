# Keylio Wallet Environment Variables
# Copy this file to .env.local and fill in your values

# ========================================
# RPC Configuration
# ========================================

# Alchemy API Key (Recommended for production)
# Get your API key from: https://dashboard.alchemy.com/
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# ========================================
# Active Chain Selection
# ========================================

# Choose which chain to use:
# - 'eth-mainnet': Ethereum Mainnet
# - 'eth-sepolia': Ethereum Sepolia Testnet
# - 'plasma-mainnet': Plasma Network Mainnet
# - 'plasma-testnet': Plasma Network Testnet
NEXT_PUBLIC_CHAIN_NAME=eth-sepolia

# ========================================
# Custom RPC URLs (Optional Overrides)
# ========================================

# Uncomment to override default Plasma RPC endpoints
# NEXT_PUBLIC_PLASMA_MAINNET_RPC=https://your-plasma-mainnet-rpc.com
# NEXT_PUBLIC_PLASMA_TESTNET_RPC=https://your-plasma-testnet-rpc.com
